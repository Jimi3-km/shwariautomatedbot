# ─────────────────────────────────────────────────────────────────────────────
# Shwari WhatsApp Agent — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
# Full Postgres connection string (used by pg pool in src/db.ts)
SUPABASE_DATABASE_URL=
# Supabase project REST URL
SUPABASE_URL=
# Public anon key (safe to expose to frontend via /api/public-env)
SUPABASE_ANON_KEY=
# Service role key (KEEP SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# ── N8N Automation ────────────────────────────────────────────────────────────
# Cloud N8N workflow URL (used for settings page display)
N8N_API_URL=
N8N_WORKFLOW_ID=
# Webhook endpoints called to route incoming WhatsApp messages
N8N_WEBHOOK_STUDENTS=
N8N_WEBHOOK_ACCESSORIES=
# Webhook called to dispatch payment receipts
N8N_WEBHOOK_SEND_RECEIPT=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Students inbox: WhatsApp Cloud API permanent token
WHATSAPP_TOKEN_STUDENTS=
# Students inbox: Phone Number ID (from Meta Business Manager)
WHATSAPP_ID_STUDENTS=
# Accessories inbox: WhatsApp Cloud API permanent token
WHATSAPP_TOKEN_ACCESSORIES=
# Accessories inbox: Phone Number ID (from Meta Business Manager)
WHATSAPP_ID_ACCESSORIES=

# ── Paystack Billing ──────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
SUBSCRIPTION_TIER=premium

# ── Admin / Godmode User ──────────────────────────────────────────────────────
# Seeded admin account — only created if not already present in Supabase Auth
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
