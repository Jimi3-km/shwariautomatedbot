# ============================================================================
# Multi-tenant AI sales platform — environment
# ----------------------------------------------------------------------------
# Copy to .env and fill in the secret. .env is gitignored; never commit it.
#
# These are the ONLY variables the application reads. Anything else you may
# have in an older .env is from the previous single-tenant app and is now
# unused — see "Obsolete" at the bottom.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Supabase ---------------------------------------------------------------
# Project: JibuWhatsapp (ref dmhqqfxlmvaeeyxdlthd)
# The server refuses to start unless all three are set, rather than serving an
# unauthenticated API.

# Public project URL. Safe — it is sent to the browser.
SUPABASE_URL=https://dmhqqfxlmvaeeyxdlthd.supabase.co

# Publishable / anon key. Public by design: it is sent to the browser and RLS
# governs everything it can reach.
SUPABASE_ANON_KEY=sb_publishable_EL8zLqi5ldXC24aiH-Rgpg_6L5tEezT

# SECRET. Server only. Bypasses RLS. Must never reach the browser or a commit.
# Supabase dashboard -> Project Settings -> API -> service_role (or
# sb_secret_default). Leave empty and the server stops with a clear message.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n --------------------------------------------------------------------
# The inbound endpoint that Telegram bot webhooks are registered against when
# a business connects a channel from Integrations. Must match the production
# URL of the "Telegram Inbound" webhook node in the n8n workflow.
N8N_TELEGRAM_WEBHOOK_URL=https://blueberrymangoes.app.n8n.cloud/webhook/telegram-in

# --- Optional ---------------------------------------------------------------
# Comma-separated allowed CORS origins. Empty reflects the request origin.
CORS_ORIGIN=

# ============================================================================
# Obsolete — DELETE these from any older .env. Nothing in the current code
# reads them:
#
#   SUPABASE_DATABASE_URL          the app talks to Supabase over HTTP now,
#                                  not a direct Postgres connection
#   N8N_API_URL                    replaced by N8N_TELEGRAM_WEBHOOK_URL
#   N8N_WORKFLOW_ID                replaced by N8N_TELEGRAM_WEBHOOK_URL
#   PAYSTACK_PUBLIC_KEY            the subscription paywall was removed
#   PAYSTACK_SECRET_KEY            the subscription paywall was removed
#   WHATSAPP_TOKEN_STUDENTS        WhatsApp is now a per-tenant row in the
#   WHATSAPP_TOKEN_ACCESSORIES     channels table, not a pair of global
#   WHATSAPP_ID_STUDENTS           Shwari inboxes in the environment
#   WHATSAPP_ID_ACCESSORIES
#   GEMINI_API_KEY                 never used by this application
# ============================================================================
