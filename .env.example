# ============================================================================
# Multi-tenant AI sales platform — environment
# ----------------------------------------------------------------------------
# Copy to .env and fill in the secret. .env is gitignored; never commit it.
#
# These are the ONLY variables the application reads. Anything else you may
# have in an older .env is from the previous single-tenant app and is now
# unused — see "Obsolete" at the bottom.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Supabase — REQUIRED ----------------------------------------------------
# The server refuses to start unless all three are set, rather than serving an
# unauthenticated API. Supabase dashboard -> Project Settings -> API.

# Public project URL. Safe — it is sent to the browser.
SUPABASE_URL=https://your-project.supabase.co

# Publishable / anon key. Public by design: it is sent to the browser and RLS
# governs everything it can reach.
SUPABASE_ANON_KEY=

# SECRET. Server only. Bypasses RLS. Must never reach the browser or a commit.
# Supabase dashboard -> Project Settings -> API -> service_role (or
# sb_secret_default). Leave empty and the server stops with a clear message.
SUPABASE_SERVICE_ROLE_KEY=

# --- Shwari, the AI workforce — REQUIRED for any AI ------------------------
# The model every agent reasons with. NVIDIA's hosted open-model API: go to
# build.nvidia.com, open any model, click "Get API Key". One key serves every
# model on that endpoint.
#
# Without it the agents cannot answer, and that is the ONLY thing that stops
# working: appointments, tickets, queued messages, the CRM and the "needs you
# today" panel are all read straight from the database and stay usable. The
# dashboard says what is missing rather than failing.
SHWARI_API_KEY=

# Optional. Any OpenAI-compatible endpoint with tool-call support works, so
# changing provider is configuration rather than code.
# SHWARI_MODEL=meta/llama-3.3-70b-instruct
# SHWARI_API_BASE=https://integrate.api.nvidia.com/v1

# --- n8n --------------------------------------------------------------------
# N8N_TELEGRAM_WEBHOOK_URL is no longer read. Telegram now delivers to
# <PUBLIC_API_URL>/api/webhooks/telegram, which records the message, then hands
# it to the pipeline below — so a conversation staff have taken over is logged
# even though the AI never answers it, and Shwari can be reached on Telegram.
# Bots connected before this change still point at n8n; Integrations flags them
# and reconnecting fixes it.

# Where normalized messages are handed to the AI pipeline. Used by WhatsApp,
# Instagram AND web chat — the pipeline resolves the channel from its secret
# and does not care which one it came from. Unset means messages still reach
# the Inbox but get no AI reply.
# (The old name N8N_META_WEBHOOK_URL is still accepted.)
N8N_AGENT_WEBHOOK_URL=

# Shared secret for server-to-server calls from n8n back into this API
# (POST /api/internal/send). This is what lets the pipeline send a reply on any
# channel without holding a bot token or a Meta access token itself.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- Meta (WhatsApp + Instagram) --------------------------------------------
# All optional. Without them the server still starts; the affected channels are
# simply reported as unavailable and their buttons are hidden, rather than
# failing halfway through a connection. Nothing here reaches the browser.

# Encrypts stored Meta access tokens (AES-256-GCM). Required for any Meta
# channel. Generate with: openssl rand -hex 32
META_TOKEN_ENCRYPTION_KEY=

# Meta app credentials — developers.facebook.com -> your app -> App settings ->
# Basic. Required for WhatsApp, and for Instagram too: inbound DMs arrive on the
# same signed webhook, which is verified with the app secret.
META_APP_ID=
META_APP_SECRET=

# Echoed back to Meta when it verifies the inbound webhook. Any random string;
# it must match what you enter in the Meta dashboard.
# Webhook callback URL to register with Meta: https://your-domain/api/webhooks/meta
META_VERIFY_TOKEN=

# WhatsApp Embedded Signup: the configuration id from the Meta app dashboard,
# and the callback this server exposes. The user never pastes a token.
META_WHATSAPP_CONFIG_ID=
META_WHATSAPP_REDIRECT_URI=https://your-domain/api/channels/oauth/whatsapp/callback

# Instagram Login for Business. Two callbacks, because signing in with
# Instagram and attaching Instagram to an existing workspace are different
# flows and Meta requires each redirect URI to be registered.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-domain/api/auth/instagram/callback
INSTAGRAM_CONNECT_REDIRECT_URI=https://your-domain/api/channels/oauth/instagram/callback

# --- Public origin — REQUIRED in production ---------------------------------
# Three things derive from this: where Telegram delivers updates
# (<PUBLIC_API_URL>/api/webhooks/telegram), the origin in the web-chat snippet a
# business pastes into their site, and the Meta redirect URIs.
#
# Defaults to http://localhost:$PORT, which is correct for development. In
# production it must be the real https origin, with no trailing slash — Telegram
# will not deliver to a URL it cannot reach.
PUBLIC_API_URL=

# --- Optional ---------------------------------------------------------------
# Comma-separated allowed CORS origins. Empty reflects the request origin.
CORS_ORIGIN=

# ============================================================================
# Obsolete — DELETE these from any older .env. Nothing in the current code
# reads them:
#
#   SUPABASE_DATABASE_URL          the app talks to Supabase over HTTP now,
#                                  not a direct Postgres connection
#   N8N_API_URL                    superseded
#   N8N_WORKFLOW_ID                superseded
#   N8N_TELEGRAM_WEBHOOK_URL       Telegram now delivers to this API directly,
#                                  at <PUBLIC_API_URL>/api/webhooks/telegram
#   PAYSTACK_PUBLIC_KEY            the subscription paywall was removed
#   PAYSTACK_SECRET_KEY            the subscription paywall was removed
#   WHATSAPP_TOKEN_STUDENTS        WhatsApp is now a per-tenant row in the
#   WHATSAPP_TOKEN_ACCESSORIES     channels table, not a pair of global
#   WHATSAPP_ID_STUDENTS           Shwari inboxes in the environment
#   WHATSAPP_ID_ACCESSORIES
#   GEMINI_API_KEY                 never used by this application
# ============================================================================
