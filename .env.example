# ============================================================================
# Multi-tenant AI sales platform — environment
# ----------------------------------------------------------------------------
# Copy to .env and fill in the secret. .env is gitignored; never commit it.
#
# These are the ONLY variables the application reads. Anything else you may
# have in an older .env is from the previous single-tenant app and is now
# unused — see "Obsolete" at the bottom.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Supabase — REQUIRED ----------------------------------------------------
# The server refuses to start unless all three are set, rather than serving an
# unauthenticated API. Supabase dashboard -> Project Settings -> API.

# Public project URL. Safe — it is sent to the browser.
SUPABASE_URL=https://your-project.supabase.co

# Publishable / anon key. Public by design: it is sent to the browser and RLS
# governs everything it can reach.
SUPABASE_ANON_KEY=

# SECRET. Server only. Bypasses RLS. Must never reach the browser or a commit.
# Supabase dashboard -> Project Settings -> API -> service_role (or
# sb_secret_default). Leave empty and the server stops with a clear message.
SUPABASE_SERVICE_ROLE_KEY=

# --- Shwari, the AI workforce — REQUIRED for any AI ------------------------
# The model every agent reasons with. NVIDIA's hosted open-model API: go to
# build.nvidia.com, open any model, click "Get API Key". One key serves every
# model on that endpoint.
#
# Without it the agents cannot answer, and that is the ONLY thing that stops
# working: appointments, tickets, queued messages, the CRM and the "needs you
# today" panel are all read straight from the database and stay usable. The
# dashboard says what is missing rather than failing.
SHWARI_API_KEY=

# Optional. Any OpenAI-compatible endpoint with function-calling support works,
# so changing provider is configuration rather than code. The model MUST support
# function calling — without it the agents will chat but never actually do
# anything, because every action happens through a function call.
# Every agent runs on nvidia/nemotron-3-ultra-550b-a55b. The model variables
# below are ignored unless SHWARI_ALLOW_MODEL_OVERRIDE=on is also set.
# SHWARI_ALLOW_MODEL_OVERRIDE=on
# SHWARI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# SHWARI_API_BASE=https://integrate.api.nvidia.com/v1

# Extended reasoning, off by default. Reasoning models spend part of the token
# budget thinking before they answer; for short conversational turns over tools
# that already validate themselves, that is slower and no more accurate.
# SHWARI_THINKING=on

# --- Internal API and scheduled jobs -----------------------------------------
# n8n is no longer part of the message path. Every channel delivers to this
# API, which records the message and answers it with the in-process agent.
#
# Shared secret for server-to-server calls into this API (POST
# /api/internal/send, POST /api/internal/follow-ups/dispatch), sent as the
# x-internal-secret header. Lets an automation send on any channel without
# holding a bot token or a Meta access token itself.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Vercel Cron authenticates with "Authorization: Bearer $CRON_SECRET". Set this
# in the Vercel project (Settings -> Environment Variables) and Vercel attaches
# the header to the jobs declared in vercel.json on its own:
#   /api/internal/cron/dispatch      due follow-ups + interrupted inbound turns
#   /api/internal/cron/maintenance   Instagram token refresh + event pruning
# Without CRON_SECRET (or INTERNAL_API_SECRET) those endpoints refuse every call.
# The schedules in vercel.json are daily because the Hobby plan allows nothing
# more frequent; on Pro, change the dispatch job to e.g. "*/5 * * * *". Between
# cron runs the same work is also done in small slices after each inbound
# message, so follow-ups are not limited to once a day on a busy account.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# How long (ms) one inbound AI turn may run before the customer is told it is
# taking too long. Must stay below the function maxDuration in vercel.json (60s).
# INBOUND_TURN_BUDGET_MS=50000

# --- Meta (WhatsApp + Instagram) --------------------------------------------
# All optional. Without them the server still starts; the affected channels are
# simply reported as unavailable and their buttons are hidden, rather than
# failing halfway through a connection. Nothing here reaches the browser.

# Encrypts stored Meta access tokens (AES-256-GCM). Required for any Meta
# channel. Generate with: openssl rand -hex 32
META_TOKEN_ENCRYPTION_KEY=

# Meta app credentials — developers.facebook.com -> your app -> App settings ->
# Basic. Required for WhatsApp, and for Instagram too: inbound DMs arrive on the
# same signed webhook, which is verified with the app secret.
META_APP_ID=
META_APP_SECRET=

# Echoed back to Meta when it verifies the inbound webhook. Any random string;
# it must match what you enter in the Meta dashboard.
# Webhook callback URL to register with Meta: https://your-domain/api/webhooks/meta
META_VERIFY_TOKEN=

# WhatsApp Embedded Signup: the configuration id from the Meta app dashboard,
# and the callback this server exposes. The user never pastes a token.
META_WHATSAPP_CONFIG_ID=
META_WHATSAPP_REDIRECT_URI=https://your-domain/api/channels/oauth/whatsapp/callback

# Instagram Login for Business. Two callbacks, because signing in with
# Instagram and attaching Instagram to an existing workspace are different
# flows and Meta requires each redirect URI to be registered.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-domain/api/auth/instagram/callback
INSTAGRAM_CONNECT_REDIRECT_URI=https://your-domain/api/channels/oauth/instagram/callback

# --- Public origin — REQUIRED in production ---------------------------------
# Three things derive from this: where Telegram delivers updates
# (<PUBLIC_API_URL>/api/webhooks/telegram), the origin in the web-chat snippet a
# business pastes into their site, and the Meta redirect URIs.
#
# Must be the real https origin with no trailing slash — Telegram will not
# deliver to a URL it cannot reach. On Vercel, if this is left empty the
# project's production domain (VERCEL_PROJECT_PRODUCTION_URL) is used; set it
# explicitly when you serve the app from a custom domain. In local development
# the web-chat snippet falls back to http://localhost:$PORT.
PUBLIC_API_URL=

# --- WhatsApp: messages outside the 24-hour window ---------------------------
# WhatsApp only accepts free-form text within 24 hours of the customer's last
# message. Later than that (a follow-up, typically) Meta accepts nothing but a
# pre-approved template. Name one here and late messages are sent through it;
# leave it empty and they fail with a clear reason instead of bouncing.
# The template must have exactly ONE body variable, {{1}}, which receives the
# message text (flattened to a single line, max 1024 characters).
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_FOLLOWUP_TEMPLATE_LANG=en

# --- Brevo Email (Transactional & Inbound) -----------------------------------
# Brevo REST API v3 key (starts with xkeysib-...) from Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=
BREVO_SENDER_NAME=shwari agent
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SMTP_LOGIN=
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# REQUIRED for inbound email (POST /api/webhooks/brevo-email). That route runs
# an AI turn and sends mail, so it refuses every call (503) until this is set.
# Configure the Brevo inbound webhook to send it in a header — either
#   x-brevo-webhook-secret: <secret>     or     Authorization: Bearer <secret>
# A secret in the URL query string is NOT accepted (it would end up in logs).
# Generate with: openssl rand -hex 32
BREVO_WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------
# Comma-separated origins allowed to call the dashboard API from a browser.
# The dashboard is served from the same origin as the API, so this is normally
# left EMPTY: in production that means same-origin only (no other site may call
# the API); in development any origin is allowed. Set it only if the frontend
# is hosted on a different origin, e.g. https://app.example.com
# The public web-chat routes (/api/webchat/*) always answer any origin, because
# the widget runs on your customers' own websites.
CORS_ORIGIN=

# ============================================================================
# Obsolete — DELETE these from any older .env. Nothing in the current code
# reads them:
#
#   SUPABASE_DATABASE_URL          the app talks to Supabase over HTTP now,
#                                  not a direct Postgres connection
#   N8N_API_URL                    superseded
#   N8N_WORKFLOW_ID                superseded
#   N8N_TELEGRAM_WEBHOOK_URL       Telegram now delivers to this API directly,
#                                  at <PUBLIC_API_URL>/api/webhooks/telegram
#   N8N_AGENT_WEBHOOK_URL          the n8n hand-off was removed; the in-process
#   N8N_META_WEBHOOK_URL           agent answers every channel
#   PAYSTACK_PUBLIC_KEY            the subscription paywall was removed
#   PAYSTACK_SECRET_KEY            the subscription paywall was removed
#   WHATSAPP_TOKEN_STUDENTS        WhatsApp is now a per-tenant row in the
#   WHATSAPP_TOKEN_ACCESSORIES     channels table, not a pair of global
#   WHATSAPP_ID_STUDENTS           Shwari inboxes in the environment
#   WHATSAPP_ID_ACCESSORIES
#   GEMINI_API_KEY                 never used by this application
# ============================================================================
