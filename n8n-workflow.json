    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst phone = b.phone || \"N/A\";\nconst email = b.email || \"\";\nconst product = b.product || \"iPhone\";\nconst storage = b.storage || \"\";\nconst condition = b.condition || \"\";\nconst amount = b.amount || \"0\";\nconst transactionCode = b.transactionCode || \"N/A\";\nconst location = b.location || \"N/A\";\nconst paymentMethod = b.paymentMethod || \"M-Pesa\";\nconst orderDate = new Date().toLocaleDateString(\"en-KE\", { year: \"numeric\", month: \"long\", day: \"numeric\" });\nconst orderId = \"SHW-\" + Date.now().toString().slice(-6);\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><style>\nbody { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 20px; }\n.container { max-width: 580px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }\n.header { background: #1a1a2e; color: white; padding: 30px; text-align: center; }\n.header h1 { margin: 0; font-size: 24px; letter-spacing: 1px; }\n.header p { margin: 6px 0 0; color: #aaa; font-size: 13px; }\n.body { padding: 30px; }\n.order-id { background: #f0f4ff; border-left: 4px solid #3b82f6; padding: 12px 16px; border-radius: 4px; margin-bottom: 24px; font-size: 13px; color: #555; }\n.order-id strong { color: #1a1a2e; font-size: 16px; display: block; }\n.section-title { font-size: 13px; font-weight: bold; text-transform: uppercase; color: #888; letter-spacing: 1px; margin: 24px 0 12px; border-bottom: 1px solid #eee; padding-bottom: 6px; }\n.row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; color: #333; border-bottom: 1px solid #f5f5f5; }\n.row .label { color: #777; }\n.total-row { display: flex; justify-content: space-between; padding: 14px 0 0; font-size: 17px; font-weight: bold; color: #1a1a2e; margin-top: 8px; }\n.badge { display: inline-block; background: #d1fae5; color: #065f46; font-size: 12px; font-weight: bold; padding: 4px 12px; border-radius: 20px; margin-top: 4px; }\n.footer { background: #f9f9f9; padding: 20px 30px; text-align: center; font-size: 12px; color: #999; border-top: 1px solid #eee; }\n.footer a { color: #3b82f6; text-decoration: none; }\n</style></head>\n<body>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>Shwari iPhones</h1>\n    <p>Official Purchase Receipt</p>\n  </div>\n  <div class=\"body\">\n    <div class=\"order-id\">\n      Order Reference<br>\n      <strong>${orderId}</strong>\n      <span class=\"badge\">Payment Confirmed</span>\n    </div>\n\n    <div class=\"section-title\">Customer Details</div>\n    <div class=\"row\"><span class=\"label\">Phone / Telegram ID</span><span>${phone}</span></div>\n    <div class=\"row\"><span class=\"label\">Email</span><span>${email}</span></div>\n    <div class=\"row\"><span class=\"label\">Delivery Location</span><span>${location}</span></div>\n\n    <div class=\"section-title\">Order Details</div>\n    <div class=\"row\"><span class=\"label\">Product</span><span>${product}</span></div>\n    <div class=\"row\"><span class=\"label\">Storage</span><span>${storage}</span></div>\n    <div class=\"row\"><span class=\"label\">Condition</span><span>${condition}</span></div>\n    <div class=\"row\"><span class=\"label\">Order Date</span><span>${orderDate}</span></div>\n\n    <div class=\"section-title\">Payment Details</div>\n    <div class=\"row\"><span class=\"label\">Payment Method</span><span>${paymentMethod}</span></div>\n    <div class=\"row\"><span class=\"label\">Transaction Code</span><span>${transactionCode}</span></div>\n    <div class=\"total-row\"><span>Total Paid</span><span>KES ${amount}</span></div>\n\n    <div class=\"section-title\">Delivery Info</div>\n    <div class=\"row\"><span class=\"label\">Estimated Delivery</span><span>Within 24 hours</span></div>\n    <div class=\"row\"><span class=\"label\">We will call you to confirm delivery</span><span></span></div>\n  </div>\n  <div class=\"footer\">\n    Thank you for choosing Shwari iPhones.<br>\n    Questions? WhatsApp us anytime.<br>\n    <a href=\"https://t.me/ShwariIphones\">t.me/ShwariIphones</a>\n  </div>\n</div>\n</body>\n</html>`;\n\nconst subject = \"Your Shwari iPhones Receipt - \" + product + \" (\" + orderId + \")\";\n\nreturn [{ json: { to: email, subject, html, phone, orderId, ...b } }];"
      },
