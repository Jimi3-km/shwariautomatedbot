      "id": "1bca1a43-da7b-4300-a6bc-6e6136b7525a",
      "name": "Pricelist Tool",
      "type": "n8n-nodes-base.supabaseTool",
      "typeVersion": 1,
      "position": [
        192,
        224
      ],
      "credentials": {
        "supabaseApi": {
