      "parameters": {
        "jsCode": "const now = new Date();\nconst cold = $input.all().map(i => i.json).filter(l => {\n  if (!l.last_contact || l.stage === \"payment_submitted\") return false;\n  return (now - new Date(l.last_contact)) / 3600000 >= 24;\n});\nreturn cold.map(l => ({ json: l }));"
